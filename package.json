{
  "name": "hyve",
  "version": "1.11.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@interactjs/actions": "^1.10.28",
    "@interactjs/auto-start": "^1.10.28",
    "@interactjs/interact": "^1.10.28",
    "geotiff": "^2.1.3",
    "pako": "2.1.0"
  },
  "scripts": {
    "dev": "vite",
    "build:bundle": "vite build",
    "build:inline": "node scripts/inline-dist.mjs",
    "build:assert": "node scripts/assert-single-file.mjs",
    "build:fmap": "node scripts/build-fmap-wasm.mjs",
    "test:fmap-core": "node scripts/test-fmap-core.mjs",
    "build": "npm run build:bundle && npm run build:inline && npm run build:assert",
    "benchmark:fmap": "node scripts/benchmark-fmap.mjs",
    "benchmark:fmap-browser": "node scripts/benchmark-fmap-browser.mjs",
    "benchmark:fmap-queues": "node scripts/benchmark-fmap-queues.mjs",
    "benchmark:fmap-reductions": "node scripts/benchmark-fmap-reductions.mjs",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage && node scripts/coverage-badge.mjs",
    "test:e2e": "playwright test",
    "test:fmap-large": "node scripts/run-fmap-large-test.mjs",
    "test:fmap-browser": "node scripts/run-fmap-browser-tests.mjs",
    "test:fmap-packaged": "node scripts/run-fmap-packaged-test.mjs",
    "test": "npm run test:unit && npm run test:e2e",
    "lint": "eslint .",
    "version:calc": "node scripts/calculate-version.mjs",
    "version:prepare": "node scripts/calculate-version.mjs --write"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "^9.35.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "vite": "^6.4.5",
    "vitest": "^4.1.12"
  }
}
